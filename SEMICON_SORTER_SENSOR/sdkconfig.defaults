# Apply these to sdkconfig as well when an existing sdkconfig is already present.
CONFIG_FMB_COMM_MODE_TCP_EN=y
# CONFIG_FMB_COMM_MODE_RTU_EN is not set
# CONFIG_FMB_COMM_MODE_ASCII_EN is not set
CONFIG_FMB_TCP_PORT_DEFAULT=502
CONFIG_FMB_TCP_UID_ENABLED=y
# CONFIG_FMB_CONTROLLER_SLAVE_ID_SUPPORT is not set
# CONFIG_FMB_MDNS_INTEGRATION_ENABLE is not set
CONFIG_FMB_CONTROLLER_NOTIFY_TIMEOUT=0
CONFIG_FMB_CONTROLLER_NOTIFY_QUEUE_SIZE=20

CONFIG_SENSOR_WIFI_SSID=""
CONFIG_SENSOR_WIFI_PASSWORD=""
